
{
  "name": "@notoriousvikas/getnotified",
  "version": "1.0.1",
  "description": "Official TypeScript/JavaScript SDK for GetNotify notification service",
  "homepage": "https://github.com/notoriousvikas/getNotifySdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/notoriousvikas/getNotifySdk.git"
  },
  "bugs": {
    "url": "https://github.com/notoriousvikas/getNotifySdk/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')){fs.rmSync('dist',{recursive:true,force:true})}\""
  },
  "keywords": [
    "getnotify",
    "notification",
    "sdk",
    "email",
    "sms",
    "push",
    "in-app",
    "typescript"
  ],
  "author": "GetNotify",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
